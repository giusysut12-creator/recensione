# Copia in .env.local (sviluppo) o imposta su Vercel → Settings → Environment Variables.
# NESSUNA di queste variabili deve avere il prefisso NEXT_PUBLIC_: restano sul server.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Schema delle tabelle. "public" con un progetto dedicato; uno schema separato (es. vdc) per usare
# un progetto Supabase già esistente: vedi README, "Supabase condiviso".
SUPABASE_SCHEMA=public

# --- Apify (Console → Settings → API & Integrations) ---
APIFY_TOKEN=
# Actor usato per le recensioni Google (default consigliato)
APIFY_GOOGLE_REVIEWS_ACTOR=compass/google-maps-reviews-scraper
# Input extra per l'Actor in JSON, solo dopo averli verificati sull'input schema. Es: {"language":"it"}
APIFY_EXTRA_INPUT=
# Tetto di spesa per singolo run in dollari (misurato: ~$0,06 ogni 100 recensioni)
APIFY_MAX_CHARGE_USD=1

# --- AI ---
AI_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
# Solo se la chiave non è legata a un workspace (errore "anthropic-workspace-id"): ID del workspace
ANTHROPIC_WORKSPACE_ID=
# Opzionali: di default fast = claude-haiku-4-5 (estrazione), smart = claude-opus-5-5 (sintesi)
AI_MODEL_FAST=
AI_MODEL_SMART=
# Con AI_PROVIDER=openai servono OPENAI_API_KEY, AI_MODEL_FAST e AI_MODEL_SMART
OPENAI_API_KEY=

# --- Accesso riservato ---
APP_ACCESS_CODE=                 # codice da comunicare a chi può usare l'app (min 6 caratteri)
APP_SESSION_SECRET=              # stringa casuale lunga (min 32 caratteri): openssl rand -hex 32

# --- Limiti ---
MAX_REVIEWS_PER_ANALYSIS=300
MAX_ANALYSES_PER_DAY=30
MAX_ANALYSES_PER_HOUR_PER_CLIENT=5
